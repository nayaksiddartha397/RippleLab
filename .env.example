# Copy this file to .env.local for local development.
# Never commit real credentials.

RIPPLELAB_ENGINE_URL=http://127.0.0.1:8000
RIPPLELAB_ENVIRONMENT=development
RIPPLELAB_ALLOWED_ORIGINS=http://localhost:3000

# Reserved for Day 3. Keep the service-role key server-side.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred current Supabase public-key name. ANON_KEY remains a documented fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=

# Never enable in production. Used only by the automated auth lifecycle suite.
RIPPLELAB_AUTH_TEST_MODE=0

# Reserved for Day 15. Keep server-side only.
LLM_API_KEY=
